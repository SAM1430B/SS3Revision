// Version information shown in the file properties of dinput8.dll.

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SS3Revision"
            VALUE "FileDescription",  "SS3 fixes and enhancements."
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "dinput8"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "SS3Revision"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
