<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release-XP|Win32">
      <Configuration>Release-XP</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{DD891BED-E0B0-46F3-8EDA-3641FF48B69D}</ProjectGuid>
    <RootNamespace>SS3Revision</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 32-bit only: the game is 32-bit and the hooks use x86 inline assembly. -->
  <!-- Debug / Release: v143, runs on Windows 7 and later.
       Release-XP: v141_xp, runs on Windows XP SP3 and later. Only that configuration needs the
       Visual Studio Installer component "C++ Windows XP Support for VS 2017 (v141) tools". -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release-XP|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v141_xp</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <!-- The output is named dinput8.dll so the game loads it from its own folder. -->
  <PropertyGroup>
    <TargetName>dinput8</TargetName>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ConformanceMode>true</ConformanceMode>
      <!-- Hooks jump into the game's code; keep frame layout predictable. -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>dinput8.def</ModuleDefinitionFile>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <Command>if not exist "$(OutDir)SS3Revision.ini" copy /y "$(ProjectDir)SS3Revision.ini" "$(OutDir)SS3Revision.ini" &gt;nul</Command>
      <Message>Copying default SS3Revision.ini next to dinput8.dll (only if missing)</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static runtime: players do not need the Visual C++ redistributable. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32' Or '$(Configuration)|$(Platform)'=='Release-XP|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release-XP|Win32'">
    <ClCompile>
      <!-- XP: no thread-safe static initialisation (it relies on TLS that XP lacks for some DLL loads). -->
      <AdditionalOptions>/Zc:threadSafeInit- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="src\Core\Config.h" />
    <ClInclude Include="src\Core\DisplayEnvironment.h" />
    <ClInclude Include="src\Core\GameAddresses.h" />
    <ClInclude Include="src\Core\Log.h" />
    <ClInclude Include="src\Core\Memory.h" />
    <ClInclude Include="src\Features\Features.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\DllMain.cpp" />
    <ClCompile Include="src\Core\Config.cpp" />
    <ClCompile Include="src\Core\DisplayEnvironment.cpp" />
    <ClCompile Include="src\Core\GameAddresses.cpp" />
    <ClCompile Include="src\Core\Log.cpp" />
    <ClCompile Include="src\Core\Memory.cpp" />
    <ClCompile Include="src\Proxy\DInput8Proxy.cpp" />
    <ClCompile Include="src\Features\OnlineGameList.cpp" />
    <ClCompile Include="src\Features\SerialPortScan.cpp" />
    <ClCompile Include="src\Features\MultipleInstances.cpp" />
    <ClCompile Include="src\Features\ResolutionList.cpp" />
    <ClCompile Include="src\Features\SavedResolution.cpp" />
    <ClCompile Include="src\Features\InterfaceScaling.cpp" />
    <ClCompile Include="src\Features\WrapperBorder.cpp" />
    <ClCompile Include="src\Features\MinimizeRestore.cpp" />
    <ClCompile Include="src\Features\MaximizeWindow.cpp" />
    <ClCompile Include="src\Features\FullscreenToggle.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="dinput8.def" />
    <None Include="SS3Revision.ini" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="SS3Revision.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>